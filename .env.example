# MongoDB connection string.
#
# Local development options:
#   - Docker:     docker run -d --name inkwell-mongo -p 27017:27017 mongo:7
#   - Homebrew:   brew install mongodb-community && brew services start mongodb-community
#   - Atlas:      create a free cluster at https://www.mongodb.com/cloud/atlas
#                 and paste its connection string below.
MONGODB_URI=mongodb+srv://rudra763orgin_db_user:rudra000@inkwell.qsa0vmj.mongodb.net/

# Database name. Collections (users, sessions, posts, comments, likes) are
# created automatically, and the database is seeded with demo data the
# first time it's empty.
MONGODB_DB=inkwell

ADMIN_EMAIL=Rudra763.org.in@gmail.com
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Inkwell <verified@yourdomain.com>
